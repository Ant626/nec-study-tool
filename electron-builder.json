{
  "appId": "com.nec.studyapp",
  "productName": "NEC Study App",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-electron/**",
    "dist/nec-study-app/**",
    "node_modules/pdfjs-dist/**"
  ],
  "asarUnpack": [
    "dist/nec-study-app/server/**",
    "node_modules/pdfjs-dist/**"
  ],
  "extraResources": [
    { "from": "src/assets/nec-book.pdf", "to": "nec-book.pdf" }
  ],
  "win": {
    "target": "nsis",
    "icon": "src/app-icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
